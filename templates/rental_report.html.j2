<!doctype html><html><body style="font-family:Arial,sans-serif;color:#172033;max-width:780px;margin:0 auto;background:#fff"><div style="padding:24px 16px">
<h1 style="margin:0 0 8px;font-size:28px">南都柏林住房租赁</h1>
<p style="margin:0 0 18px;color:#526078;line-height:1.55">核验时间：{{generated_at}}。私人整租按总月租、户型实用性、位置和来源可靠度综合排序；优先一室一厅，也保留位置稍远但总价更低的选择。</p>
<div style="background:#f8fafc;border:1px solid #d9e0ea;border-radius:12px;padding:13px;margin-bottom:18px;line-height:1.55"><b>固定来源：</b>{{sources|join('、')}}。仅展示公开房源信息，不包含任何个人姓名、雇主或收入信息。</div>
<h2 style="font-size:21px;margin:22px 0 8px">出租位置总览</h2>
{% if map_src %}<img src="{{map_src}}" width="640" alt="都柏林出租房源地图" style="display:block;width:100%;max-width:640px;height:auto;border-radius:10px;margin:0 auto 8px">{% elif map_error %}<p style="color:#8a4b08">地图暂不可用：{{map_error}}</p>{% endif %}
{% if map_labels %}<table role="presentation" width="100%" style="border-collapse:collapse;font-size:12px;margin-bottom:18px">{% for item in map_labels %}<tr><td style="width:32px;padding:4px"><b>{{item.label}}</b></td><td style="padding:4px"><b>{{item.title}}</b><br><span style="color:#667085">{{item.address}}</span></td></tr>{% endfor %}</table>{% endif %}
<h2 style="font-size:22px;border-left:5px solid #e67e22;padding-left:10px">私人整租｜性价比排序</h2>
{% for row in rentals %}{% set x=row.listing %}<article style="border:1px solid #d9e0ea;border-radius:12px;padding:15px;margin:12px 0"><div style="font-size:12px;color:#667085"><b style="background:#fff3e7;color:#a44b00;border-radius:999px;padding:3px 8px">第 {{row.rank}} 名 · 地图 {{row.marker}}</b>　综合分 {{row.score}}</div><h3 style="margin:8px 0;font-size:18px">{{x.display_title}}</h3><p style="margin:5px 0"><b>€{{'{:,}'.format(x.rent_eur)}}/月</b> · {{x.bedrooms}} Bed{% if x.bathrooms is not none %} · {{x.bathrooms}} Bath{% endif %} · {{x.property_type}}</p><p style="margin:5px 0;color:#475467">{{x.address}} · {{x.district}}</p>{% if x.lease_term %}<p style="margin:5px 0;color:#475467"><b>租期：</b>{{x.lease_term}}</p>{% endif %}{% if x.notes %}<p style="color:#475467"><b>说明：</b>{{x.notes}}</p>{% endif %}<p><a href="{{x.url}}" style="font-weight:bold">打开原始房源</a>　|　<a href="{{x.google_maps_url}}">Google Maps</a></p></article>{% else %}<p style="color:#667085">本期没有核实到符合条件的整租房源。</p>{% endfor %}
<h2 style="font-size:22px;border-left:5px solid #16a34a;padding-left:10px;margin-top:30px">Cost Rental｜公开项目与申请条件</h2>
{% for x in cost_rental %}<article style="border:1px solid #cfe8d5;border-radius:12px;padding:15px;margin:12px 0;background:#f5fbf6"><h3 style="margin:0 0 8px;font-size:18px">{{x.title}}{% if x.provider %}（{{x.provider}}）{% endif %}</h3><p style="margin:5px 0">{% if x.rent_eur %}<b>€{{'{:,}'.format(x.rent_eur)}}/月</b>{% endif %}{% if x.bedrooms is not none %} · {{x.bedrooms}} Bed{% endif %}</p><p style="margin:5px 0;color:#475467"><b>状态：</b>{{x.status}}</p><div style="background:#fff;border:1px solid #d8eadc;border-radius:9px;padding:10px"><b>申请条件：</b>{{x.eligibility}}</div>{% if x.notes %}<p style="color:#475467">{{x.notes}}</p>{% endif %}<p><a href="{{x.url}}" style="font-weight:bold">打开官方项目页</a></p></article>{% else %}<p style="color:#667085">本期没有新增 Cost Rental 项目。</p>{% endfor %}
<p style="font-size:12px;color:#667085;margin-top:22px;line-height:1.45">出租状态变化很快；联系前请重新确认是否仍可预约、押金、租期、入住人数限制及 RTB 登记情况。</p></div></body></html>
