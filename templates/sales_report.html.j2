<!doctype html><html><body style="margin:0;background:#f3f5f8;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif;color:#172033"><div style="max-width:780px;margin:0 auto;background:#fff;padding:26px 18px 36px">
<div style="border-bottom:1px solid #e4e8ef;padding-bottom:18px"><h1 style="margin:0 0 8px;font-size:28px;line-height:1.25">南都柏林住房销售</h1><p style="margin:0;color:#667085;font-size:14px;line-height:1.6">更新日期：{{updated_date}} · 信息核验：{{verified_label}}</p></div>
<div style="margin:18px 0 8px;padding:14px 15px;border:1px solid #cfe2ff;background:#eef6ff;border-radius:12px;line-height:1.65"><b>本期重点：</b>{{focus_summary}}</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="8" style="margin:14px -8px 18px;border-collapse:separate"><tr>
<td style="border:1px solid #d9e0ea;border-radius:12px;padding:12px;background:#f8fafc"><div style="font-size:12px;color:#667085">本期条目</div><b style="font-size:22px">{{total_count}}</b></td>
<td style="border:1px solid #d9e0ea;border-radius:12px;padding:12px;background:#f8fafc"><div style="font-size:12px;color:#667085">独立地图位置</div><b style="font-size:22px">{{location_count}}</b></td>
<td style="border:1px solid #d9e0ea;border-radius:12px;padding:12px;background:#f8fafc"><div style="font-size:12px;color:#667085">当前重点</div><b style="font-size:22px">{{focus_count}}</b></td>
</tr></table>
<section style="border:1px solid #d9e0ea;border-radius:14px;padding:16px;margin:18px 0;background:#f8fafc">
<h2 style="margin:0 0 8px;font-size:20px">所有房源位置总览</h2>
<p style="margin:0 0 12px;color:#667085;font-size:13px;line-height:1.6">同一项目共用一个地图点位；地图编号、下方地点清单和房源卡片编号完全一致。</p>
<a href="{{map_overview_url}}" style="text-decoration:none"><img src="{{google_static_map_url}}" alt="南都柏林住房销售 Google Maps 总览" width="640" style="display:block;width:100%;max-width:640px;height:auto;border:0;border-radius:10px;margin:0 auto 12px"></a>
<p style="margin:0 0 12px;font-size:12px;line-height:1.8;text-align:center">
<span style="display:inline-block;margin:0 7px"><span style="display:inline-block;width:9px;height:9px;border-radius:50%;background:#0f766e;margin-right:5px"></span>Coming Soon</span>
<span style="display:inline-block;margin:0 7px"><span style="display:inline-block;width:9px;height:9px;border-radius:50%;background:#2563eb;margin-right:5px"></span>Affordable Purchase</span>
<span style="display:inline-block;margin:0 7px"><span style="display:inline-block;width:9px;height:9px;border-radius:50%;background:#7c3aed;margin-right:5px"></span>开发商／销售代理新房</span>
<span style="display:inline-block;margin:0 7px"><span style="display:inline-block;width:9px;height:9px;border-radius:50%;background:#dc2626;margin-right:5px"></span>二手 House</span>
<span style="display:inline-block;margin:0 7px"><span style="display:inline-block;width:9px;height:9px;border-radius:50%;background:#f59e0b;margin-right:5px"></span>价格变化</span>
<span style="display:inline-block;margin:0 7px"><span style="display:inline-block;width:9px;height:9px;border-radius:50%;background:#6b7280;margin-right:5px"></span>Planning／Watchlist</span>
</p>
<div style="font-size:12px;line-height:1.9;color:#475467">{% for item in map_labels %}<span style="display:inline-block;margin-right:14px;white-space:nowrap"><span style="display:inline-block;width:9px;height:9px;border-radius:50%;background:{{item.color}};margin-right:5px"></span><b>{{item.label}}</b> {{item.title}}</span>{% endfor %}</div>
<p style="margin:14px 0 0;text-align:center"><a href="{{map_overview_url}}" style="display:inline-block;background:#1967d2;color:#fff;text-decoration:none;font-weight:bold;padding:10px 14px;border-radius:8px">在 Google Maps 中打开总览</a></p>
</section>
{% for section in sections %}<section style="margin:28px 0"><h2 style="font-size:22px;border-left:5px solid {{section['color']}};padding-left:10px">{{section['title']}}</h2>
{% if section['key'] == 'market_watch' %}
<div style="border:1px solid #d8dee9;border-radius:14px;padding:16px;background:#f8f9fb;line-height:1.65">{% for row in section['items'] %}{% set x=row.listing %}<p style="line-height:1.6;margin:12px 0"><b>{{row.marker}} · {{x.display_title}}</b>：{% if x.notes %}{{x.notes}}{% else %}{{x.status}}{% endif %}　<a href="{{x.google_maps_url}}">Google Maps</a></p>{% else %}<p style="color:#667085">本期没有 Watchlist 项目。</p>{% endfor %}</div>
{% else %}
{% for row in section['items'] %}{% set x=row.listing %}<article style="border:1px solid #d9e0ea;border-radius:14px;padding:16px;margin:12px 0"><div style="font-size:12px;color:#667085"><b>{{row.marker}} · {{x.status}}</b></div><h3 style="margin:8px 0;font-size:18px">{{x.display_title}}</h3><p style="margin:5px 0">{% if x.price_eur %}<b>€{{'{:,}'.format(x.price_eur)}}</b>{% else %}<b>Price on Application</b>{% endif %}{% if x.bedrooms is not none %} · {{x.bedrooms}} Bed{% endif %}{% if x.bathrooms is not none %} · {{x.bathrooms}} Bath{% endif %}{% if x.property_type %} · {{x.property_type}}{% endif %}{% if x.ber %} · BER {{x.ber}}{% endif %}</p><p style="margin:5px 0;color:#475467">{{x.address}}</p>{% if x.notes %}<p style="color:#475467;line-height:1.55">{{x.notes}}</p>{% endif %}{% if x.eligibility %}<div style="background:#f0f7ff;border:1px solid #cfe3ff;border-radius:9px;padding:10px"><b>申请条件：</b>{{x.eligibility}}</div>{% endif %}<p><a href="{{x.url}}" style="font-weight:bold">查看原始项目页</a>　|　<a href="{{x.google_maps_url}}">Google Maps</a></p></article>{% else %}<p style="color:#667085">本期没有合适项目。</p>{% endfor %}
{% endif %}</section>{% endfor %}
<div style="margin-top:26px;padding-top:18px;border-top:1px solid #e4e8ef;color:#667085;font-size:12px;line-height:1.65">房源状态、价格、开放日期和销售阶段可能随时变化。邮件同时覆盖开发商官网、销售代理、新房平台、Affordable Housing 与公开 Planning 信息；预约看房、申请或出价前，请在原始页面再次确认。</div></div></body></html>