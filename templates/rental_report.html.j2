<!doctype html><html><body style="margin:0;background:#f3f5f8;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif;color:#172033"><div style="max-width:780px;margin:0 auto;background:#fff;padding:26px 18px 36px">
<div style="border-bottom:1px solid #e4e8ef;padding-bottom:18px"><h1 style="margin:0 0 8px;font-size:28px;line-height:1.25">南都柏林住房租赁</h1><p style="margin:0;color:#667085;font-size:14px;line-height:1.6">更新日期：{{updated_date}} · 信息核验：{{verified_label}}</p></div>
<div style="margin:18px 0 8px;padding:14px 15px;border:1px solid #cfe2ff;background:#eef6ff;border-radius:12px;line-height:1.65"><b>本期重点：</b>{{focus_summary}}</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="8" style="margin:14px -8px 10px;border-collapse:separate"><tr>
<td style="border:1px solid #d9e0ea;border-top:4px solid #172033;border-radius:12px;padding:12px;background:#f8fafc"><div style="font-size:12px;color:#667085">本期条目</div><b style="font-size:22px">{{total_count}}</b><div style="font-size:11px;color:#667085;margin-top:4px">下方房源／项目卡片</div></td>
<td style="border:1px solid #d9e0ea;border-top:4px solid #1967d2;border-radius:12px;padding:12px;background:#f8fafc"><div style="font-size:12px;color:#667085">独立地图位置</div><b style="font-size:22px">{{location_count}}</b><div style="font-size:11px;color:#667085;margin-top:4px">对应地图编号点位</div></td>
<td style="border:1px solid #d9e0ea;border-top:4px solid #16a34a;border-radius:12px;padding:12px;background:#f8fafc"><div style="font-size:12px;color:#667085">当前重点</div><b style="font-size:22px">{{focus_count}}</b><div style="font-size:11px;color:#667085;margin-top:4px">私人整租与开放项目</div></td>
</tr></table>
<div style="border:1px solid #d9e0ea;border-radius:12px;padding:11px 12px;background:#fff;margin:0 0 18px"><div style="font-size:12px;font-weight:bold;color:#475467;margin-bottom:7px">地图颜色汇总（各颜色数量之和＝{{location_count}} 个地图点位）</div><div style="font-size:12px;line-height:2"><span style="display:inline-block;margin-right:12px;white-space:nowrap"><span style="display:inline-block;width:9px;height:9px;border-radius:50%;background:#e67e22;margin-right:5px"></span>私人整租 <b>{{map_color_counts.orange}}</b></span><span style="display:inline-block;margin-right:12px;white-space:nowrap"><span style="display:inline-block;width:9px;height:9px;border-radius:50%;background:#16a34a;margin-right:5px"></span>Cost Rental <b>{{map_color_counts.green}}</b></span><span style="display:inline-block;margin-right:12px;white-space:nowrap"><span style="display:inline-block;width:9px;height:9px;border-radius:50%;background:#6b7280;margin-right:5px"></span>Watchlist <b>{{map_color_counts.gray}}</b></span></div></div>
<section style="border:1px solid #d9e0ea;border-radius:14px;padding:16px;margin:18px 0;background:#f8fafc"><h2 style="margin:0 0 8px;font-size:20px">所有出租位置总览</h2><p style="margin:0 0 12px;color:#667085;font-size:13px;line-height:1.6">同一地址共用一个地图点位；地图编号、下方地点清单和房源卡片编号完全一致。</p><a href="{{map_overview_url}}" style="text-decoration:none"><img src="{{google_static_map_url}}" alt="南都柏林住房租赁 Google Maps 总览" width="640" style="display:block;width:100%;max-width:640px;height:auto;border:0;border-radius:10px;margin:0 auto 12px"></a><p style="margin:0 0 12px;font-size:12px;line-height:1.8;text-align:center"><span style="display:inline-block;margin:0 7px"><span style="display:inline-block;width:9px;height:9px;border-radius:50%;background:#e67e22;margin-right:5px"></span>私人整租</span><span style="display:inline-block;margin:0 7px"><span style="display:inline-block;width:9px;height:9px;border-radius:50%;background:#16a34a;margin-right:5px"></span>Cost Rental</span><span style="display:inline-block;margin:0 7px"><span style="display:inline-block;width:9px;height:9px;border-radius:50%;background:#6b7280;margin-right:5px"></span>待核实／已关闭／申请结束</span></p><div style="font-size:12px;line-height:1.9;color:#475467">{% for item in map_labels %}<span style="display:inline-block;margin-right:14px;white-space:nowrap"><span style="display:inline-block;width:9px;height:9px;border-radius:50%;background:{% if item.color == 'orange' %}#e67e22{% elif item.color == 'green' %}#16a34a{% else %}#6b7280{% endif %};margin-right:5px"></span><b>{{item.label}}</b> {{item.title}}</span>{% endfor %}</div><p style="margin:14px 0 0;text-align:center"><a href="{{map_overview_url}}" style="display:inline-block;background:#1967d2;color:#fff;text-decoration:none;font-weight:bold;padding:10px 14px;border-radius:8px">在 Google Maps 中打开总览</a></p></section>
<h2 style="font-size:22px;border-left:5px solid #e67e22;padding-left:10px;margin-top:28px">私人整租 · 性价比排序</h2>
{% for row in rentals %}{% set x=row.listing %}<article style="border:2px solid #f2b27a;border-radius:14px;padding:16px;margin:12px 0;background:#fffaf6"><div style="font-size:12px;color:#b45309;font-weight:800">{{row.marker}} · 第 {{row.rank}} 名 · Available</div><h3 style="margin:6px 0 8px;font-size:19px">{{x.display_title}}</h3><p style="margin:5px 0"><b>€{{'{:,}'.format(x.rent_eur)}}/月 · {{x.bedrooms}} Bed{% if x.bathrooms is not none %} · {{x.bathrooms}} Bath{% endif %} · {{x.property_type}}</b></p><p style="margin:7px 0;color:#475467;line-height:1.6">{{x.address}}{% if x.lease_term %} · {{x.lease_term}}{% endif %}{% if x.notes %}<br>{{x.notes}}{% endif %}</p><p style="margin:10px 0 0"><a href="{{x.url}}" style="font-weight:700;color:#b45309">直接打开具体房源页</a>　|　<a href="{{x.google_maps_url}}" style="color:#b45309">Google Maps</a></p></article>{% endfor %}
{% if cost_rental %}<h2 style="font-size:22px;border-left:5px solid #16a34a;padding-left:10px;margin-top:30px">Cost Rental · 当前开放</h2>{% for row in cost_rental %}{% set x=row.project %}<article style="border:2px solid #9bd5a8;border-radius:14px;padding:16px;margin:12px 0;background:#f5fbf6"><div style="font-size:12px;color:#15803d;font-weight:800">{{row.marker}} · {{x.status}}</div><h3 style="margin:6px 0 8px;font-size:19px">{{x.title}}{% if x.provider %}（{{x.provider}}）{% endif %}</h3><p style="margin:5px 0"><b>{% if x.rent_eur %}€{{'{:,}'.format(x.rent_eur)}}/月{% endif %}{% if x.bedrooms is not none %} · {{x.bedrooms}} Bed{% endif %}</b></p><p style="margin:7px 0;color:#475467;line-height:1.6">{{x.address}}<br>{{x.eligibility}}{% if x.notes %}<br>{{x.notes}}{% endif %}</p><p style="margin:10px 0 0"><a href="{{x.url}}" style="font-weight:700;color:#15803d">直接打开具体项目页</a>　|　<a href="https://www.google.com/maps/search/?api=1&query={{x.address|urlencode}}" style="color:#15803d">Google Maps</a></p></article>{% endfor %}{% endif %}
<h2 style="font-size:21px;margin:28px 0 12px;color:#475467">Watchlist</h2><div style="border:1px solid #d8dee9;border-radius:14px;padding:16px;background:#f8f9fb;line-height:1.65">{% for row in watchlist %}{% set x=row.project %}<article style="border:1px solid #d8dee9;border-radius:12px;padding:14px;margin:10px 0;background:#fff"><div style="font-size:12px;color:#667085;font-weight:800">{{row.marker}} · {{x.status}}</div><h3 style="margin:6px 0 8px;font-size:18px">{{x.title}}{% if x.provider %}（{{x.provider}}）{% endif %}</h3><p style="margin:6px 0;color:#475467;line-height:1.6">{{x.address}}{% if x.rent_eur %} · €{{'{:,}'.format(x.rent_eur)}}/月{% endif %}{% if x.notes %}<br>{{x.notes}}{% endif %}</p><p style="margin:8px 0 0"><a href="{{x.url}}" style="font-weight:700;color:#475467">查看具体项目页</a>　|　<a href="https://www.google.com/maps/search/?api=1&query={{x.address|urlencode}}" style="color:#475467">Google Maps</a></p></article>{% endfor %}</div>
<div style="margin-top:26px;padding-top:18px;border-top:1px solid #e4e8ef;color:#667085;font-size:12px;line-height:1.65">出租状态、租金、开放日期和申请阶段可能随时变化。邮件固定检查 Daft.ie，并补充可靠直接出租平台及 Cost Rental 官方来源；联系、预约或申请前，请在具体房源或项目页面再次确认。正文仅使用公开房源信息，不包含个人姓名、工作单位或收入信息。</div></div></body></html>
