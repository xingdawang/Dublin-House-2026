<!doctype html><html><body style="font-family:Arial,sans-serif;color:#172033;max-width:780px;margin:0 auto;background:#fff"><div style="padding:24px 16px">
<h1 style="margin:0 0 8px;font-size:28px">南都柏林住房租赁</h1>
<p style="margin:0 0 8px;color:#526078;line-height:1.55">更新日期：{{updated_date}} · 信息核验：{{verified_label}}</p>
<p style="margin:0 0 18px;line-height:1.65"><b>本期重点：</b>{{focus_summary}}</p>
<table role="presentation" width="100%" cellpadding="0" cellspacing="8" style="margin:0 -8px 18px;border-collapse:separate"><tr>
<td style="border:1px solid #d9e0ea;border-radius:12px;padding:12px;background:#f8fafc"><div style="font-size:12px;color:#667085">本期条目</div><b style="font-size:22px">{{total_count}}</b></td>
<td style="border:1px solid #d9e0ea;border-radius:12px;padding:12px;background:#f8fafc"><div style="font-size:12px;color:#667085">独立地图位置</div><b style="font-size:22px">{{location_count}}</b></td>
<td style="border:1px solid #d9e0ea;border-radius:12px;padding:12px;background:#f8fafc"><div style="font-size:12px;color:#667085">当前重点</div><b style="font-size:22px">{{focus_count}}</b></td>
</tr></table>
<div style="background:#f8fafc;border:1px solid #d9e0ea;border-radius:12px;padding:13px;margin-bottom:18px;line-height:1.55"><b>固定来源：</b>{{sources|join('、')}}。仅展示公开房源信息，不包含个人姓名、雇主或收入信息。</div>
<section style="border:1px solid #d9e0ea;border-radius:14px;padding:16px;margin:18px 0;background:#f8fafc">
<h2 style="margin:0 0 8px;font-size:20px">所有出租位置总览</h2>
<p style="margin:0 0 12px;color:#667085;font-size:13px">同一项目共用一个地图点位；编号与下方房源卡片一致。</p>
<p style="margin:0 0 14px"><a href="{{map_overview_url}}" style="display:inline-block;background:#1967d2;color:#fff;text-decoration:none;font-weight:bold;padding:10px 14px;border-radius:8px">南都柏林住房租赁位置总览</a></p>
<p style="font-size:12px;line-height:1.7"><span style="color:#e67e22;font-weight:bold">橙色＝私人整租</span>；<span style="color:green;font-weight:bold">绿色＝Cost Rental</span></p>
<p style="font-size:13px;line-height:2;margin:8px 0 0">{% for item in map_labels %}<span style="display:inline-block;margin-right:14px"><b>{{item.label}}</b> {{item.title}}</span>{% endfor %}</p>
</section>
<h2 style="font-size:22px;border-left:5px solid #e67e22;padding-left:10px">私人整租 · 性价比排序</h2>
{% for row in rentals %}{% set x=row.listing %}<article style="border:1px solid #d9e0ea;border-radius:12px;padding:15px;margin:12px 0"><div style="font-size:12px;color:#667085"><b>{{row.marker}} · 第 {{row.rank}} 名</b>　综合分 {{row.score}}</div><h3 style="margin:8px 0;font-size:18px">{{x.display_title}}</h3><p style="margin:5px 0"><b>€{{'{:,}'.format(x.rent_eur)}}/月</b> · {{x.bedrooms}} Bed{% if x.bathrooms is not none %} · {{x.bathrooms}} Bath{% endif %} · {{x.property_type}}</p><p style="margin:5px 0;color:#475467">{{x.address}} · {{x.district}}</p>{% if x.lease_term %}<p style="margin:5px 0;color:#475467"><b>租期：</b>{{x.lease_term}}</p>{% endif %}{% if x.notes %}<p style="color:#475467"><b>说明：</b>{{x.notes}}</p>{% endif %}<p><a href="{{x.url}}" style="font-weight:bold">直接打开具体房源页</a>　|　<a href="{{x.google_maps_url}}">Google Maps</a></p></article>{% else %}<p style="color:#667085">本期没有核实到符合条件的整租房源。</p>{% endfor %}
<h2 style="font-size:22px;border-left:5px solid #16a34a;padding-left:10px;margin-top:30px">Cost Rental · 公开项目与申请条件</h2>
{% for row in cost_rental %}{% set x=row.project %}<article style="border:1px solid #cfe8d5;border-radius:12px;padding:15px;margin:12px 0;background:#f5fbf6"><div style="font-size:12px;color:#667085"><b>{{row.marker}} · {{x.status}}</b></div><h3 style="margin:8px 0;font-size:18px">{{x.title}}{% if x.provider %}（{{x.provider}}）{% endif %}</h3><p style="margin:5px 0">{% if x.rent_eur %}<b>€{{'{:,}'.format(x.rent_eur)}}/月</b>{% endif %}{% if x.bedrooms is not none %} · {{x.bedrooms}} Bed{% endif %}</p><p style="margin:5px 0;color:#475467">{{x.address}}</p><div style="background:#fff;border:1px solid #d8eadc;border-radius:9px;padding:10px"><b>申请条件：</b>{{x.eligibility}}</div>{% if x.notes %}<p style="color:#475467">{{x.notes}}</p>{% endif %}<p><a href="{{x.url}}" style="font-weight:bold">直接打开具体项目页</a>　|　<a href="https://www.google.com/maps/search/?api=1&query={{x.address|urlencode}}">Google Maps</a></p></article>{% else %}<p style="color:#667085">本期没有新增 Cost Rental 项目。</p>{% endfor %}
<p style="font-size:12px;color:#667085;margin-top:22px;line-height:1.45">出租状态变化很快，联系前请重新确认是否仍可预约、押金、租期、入住人数限制及 RTB 登记情况。</p></div></body></html>
