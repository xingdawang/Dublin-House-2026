<!doctype html><html><body style="font-family:Arial,sans-serif;color:#172033;max-width:780px;margin:0 auto;background:#fff"><div style="padding:24px 16px">
<h1 style="margin:0 0 8px;font-size:28px">南都柏林住房租赁</h1>
<p style="margin:0 0 18px;color:#526078;line-height:1.55">核验时间：{{generated_at}}。私人整租按总月租、户型实用性、位置和来源可靠度综合排序；Cost Rental 单独展示。</p>
<section style="border:1px solid #d8eadc;border-radius:14px;padding:16px;margin:0 0 18px;background:#f5fbf6">
<h2 style="margin:0 0 10px;font-size:20px">本期新闻与市场更新</h2>
<ul style="margin:0;padding-left:20px;line-height:1.65;color:#344054">{% for item in news_items %}<li style="margin:5px 0">{{item}}</li>{% endfor %}</ul>
</section>
<table role="presentation" width="100%" cellpadding="0" cellspacing="8" style="margin:0 -8px 18px;border-collapse:separate"><tr>
<td style="border:1px solid #d9e0ea;border-radius:12px;padding:12px;background:#f8fafc"><div style="font-size:12px;color:#667085">本期条目</div><b style="font-size:22px">{{total_count}}</b></td>
<td style="border:1px solid #d9e0ea;border-radius:12px;padding:12px;background:#f8fafc"><div style="font-size:12px;color:#667085">独立地图位置</div><b style="font-size:22px">{{location_count}}</b></td>
<td style="border:1px solid #d9e0ea;border-radius:12px;padding:12px;background:#f8fafc"><div style="font-size:12px;color:#667085">当前重点</div><b style="font-size:22px">{{focus_count}}</b></td>
</tr></table>
<div style="background:#f8fafc;border:1px solid #d9e0ea;border-radius:12px;padding:13px;margin-bottom:18px;line-height:1.55"><b>固定来源：</b>{{sources|join('、')}}。仅展示公开房源信息，不包含个人姓名、雇主或收入信息。</div>
<section style="border:1px solid #d9e0ea;border-radius:14px;padding:16px;margin:18px 0;background:#f8fafc">
<h2 style="margin:0 0 8px;font-size:20px">所有出租位置总览</h2>
<p style="margin:0 0 12px;color:#667085;font-size:13px">同一项目共用一个点位；编号与下方详情卡片一致。</p>
{% if map_src %}<img src="{{map_src}}" width="640" alt="南都柏林住房租赁位置总览" style="display:block;width:100%;max-width:640px;height:auto;border:0;border-radius:10px;margin:0 auto 10px">{% elif map_error %}<p style="color:#8a4b08">地图暂不可用：{{map_error}}</p>{% endif %}
<p style="font-size:12px;line-height:1.7;text-align:center"><span style="color:#e67e22;font-weight:bold">橙色＝私人整租</span>；<span style="color:green;font-weight:bold">绿色＝Cost Rental</span></p>
{% if map_labels %}<table role="presentation" width="100%" style="border-collapse:collapse;font-size:12px">{% for item in map_labels %}<tr><td style="width:32px;padding:4px"><b>{{item.label}}</b></td><td style="padding:4px"><b>{{item.title}}</b><br><span style="color:#667085">{{item.address}}</span></td></tr>{% endfor %}</table>{% endif %}
</section>
<h2 style="font-size:22px;border-left:5px solid #e67e22;padding-left:10px">私人整租｜性价比排序</h2>
{% for row in rentals %}{% set x=row.listing %}<article style="border:1px solid #d9e0ea;border-radius:12px;padding:15px;margin:12px 0"><div style="font-size:12px;color:#667085"><b style="background:#fff3e7;color:#a44b00;border-radius:999px;padding:3px 8px">第 {{row.rank}} 名 · 地图 {{row.marker}}</b>　综合分 {{row.score}}</div><h3 style="margin:8px 0;font-size:18px">{{x.display_title}}</h3><p style="margin:5px 0"><b>€{{'{:,}'.format(x.rent_eur)}}/月</b> · {{x.bedrooms}} Bed{% if x.bathrooms is not none %} · {{x.bathrooms}} Bath{% endif %} · {{x.property_type}}</p><p style="margin:5px 0;color:#475467">{{x.address}} · {{x.district}}</p>{% if x.lease_term %}<p style="margin:5px 0;color:#475467"><b>租期：</b>{{x.lease_term}}</p>{% endif %}{% if x.notes %}<p style="color:#475467"><b>说明：</b>{{x.notes}}</p>{% endif %}<p><a href="{{x.url}}" style="font-weight:bold">直接打开具体房源页</a>　|　<a href="{{x.google_maps_url}}">Google Maps</a></p></article>{% else %}<p style="color:#667085">本期没有核实到符合条件的整租房源。</p>{% endfor %}
<h2 style="font-size:22px;border-left:5px solid #16a34a;padding-left:10px;margin-top:30px">Cost Rental｜公开项目与申请条件</h2>
{% for row in cost_rental %}{% set x=row.project %}<article style="border:1px solid #cfe8d5;border-radius:12px;padding:15px;margin:12px 0;background:#f5fbf6"><div style="font-size:12px;color:#667085"><b>地图点位 {{row.marker}}</b> · {{x.source}}</div><h3 style="margin:8px 0;font-size:18px">{{x.title}}{% if x.provider %}（{{x.provider}}）{% endif %}</h3><p style="margin:5px 0">{% if x.rent_eur %}<b>€{{'{:,}'.format(x.rent_eur)}}/月</b>{% endif %}{% if x.bedrooms is not none %} · {{x.bedrooms}} Bed{% endif %}</p><p style="margin:5px 0;color:#475467"><b>状态：</b>{{x.status}}</p><div style="background:#fff;border:1px solid #d8eadc;border-radius:9px;padding:10px"><b>申请条件：</b>{{x.eligibility}}</div>{% if x.notes %}<p style="color:#475467">{{x.notes}}</p>{% endif %}<p><a href="{{x.url}}" style="font-weight:bold">直接打开具体项目页</a></p></article>{% else %}<p style="color:#667085">本期没有新增 Cost Rental 项目。</p>{% endfor %}
<p style="font-size:12px;color:#667085;margin-top:22px;line-height:1.45">所有按钮必须直达具体项目或具体房源详情页；首页、搜索页、地区列表页和分类页不作为有效链接。出租状态变化很快，联系前请重新确认是否仍可预约、押金、租期、入住人数限制及 RTB 登记情况。</p></div></body></html>
